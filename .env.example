# ─ Discord Bot Credentials (Required) ───────────────────────────────────
# Create a bot at https://discord.com/developers/applications
# Enable: Message Content Intent, Server Members Intent, Voice States
DISCORD_BOT_TOKEN=

# ─ Logging ──────────────────────────────────────────────────────────────
# Levels: ERROR (only errors), WARN, INFO (default), DEBUG (verbose),
#         TRACE (extremely verbose, for development)
LOG_LEVEL=INFO

# ─ External Executables (Custom Paths) ──────────────────────────────────
# Path to ffmpeg/yt-dlp. Defaults to system PATH if left empty.
# Common: ffmpeg, yt-dlp (or full paths like /usr/bin/ffmpeg)
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp

# ─ Custom Emojis ────────────────────────────────────────────────────────
# Optional: Use custom server emojis for platform indicators in embeds
# Format: <:name:id> — e.g. <:spotify:123456789012345678>
EMOJI_SPOTIFY=
EMOJI_YOUTUBE=
EMOJI_SOUNDCLOUD=

# ─ Language ─────────────────────────────────────────────────────────────
# Select interface language. All user-facing strings (embeds, buttons,
# error messages, descriptions) are translated.
#   en = English (default)
#   id = Indonesian (Bahasa Indonesia)
BOT_LANG=en

# ─ Now Playing Card Behavior ────────────────────────────────────────────
# Controls how the Now Playing embed updates when the queue advances to
# the next track. Pick whichever feels cleaner for your server.
#
#   old = Keep history (default). Each track posts a brand new card in
#         the channel. Previous cards stay visible — you can scroll up
#         to see what was played. When the queue finishes, a separate
#         "done" message is posted.
#         Example channel timeline:
#           [Now Playing: Track 1] -> [Now Playing: Track 2] -> [Done]
#
#   new = Clean channel. The previous card is deleted before the new
#         one is posted, so only one card is visible at any time. When
#         the queue finishes, the last card is edited in-place to show
#         "Queue finished" — no extra message.
#         Example channel timeline:
#           [Now Playing: Track 1] -> [Now Playing: Track 2] -> (edited: Done)
#
# Default: new (clean channel). Change to "old" to keep track history cards.
NOW_PLAYING_BEHAVIOR=new

# ─ Playlist & Radio/Mix Cap ─────────────────────────────────────────────
# Maximum number of tracks to load from YouTube playlists, mixes (list=RD),
# YouTube Radio, or Spotify playlists/albums.
# Setting a limit speeds up loading and prevents queue flooding.
# Default is 50. Set to 0 for unlimited.
MAX_PLAYLIST_ITEMS=50

# ─ MongoDB Database (Personal Playlist Storage) ─────────────────────────
# OPTIONAL — Leave ALL MongoDB fields blank to use the default local file storage
# (data/playlists.json). This works out-of-the-box for new users with zero setup.
#
# Fill these only if you want cloud-synced playlists across multiple bot instances.
# Recommended: MongoDB Atlas free tier (https://www.mongodb.com/cloud/atlas).
#
# Required fields if using MongoDB:
#   MONGO_USER         — your Atlas database user
#   MONGO_PASSWORD     — your Atlas database password
#   MONGO_HOST         — your cluster host (e.g. cluster0.abc123.mongodb.net)
#   MONGO_APP_NAME     — your Atlas app name (default: Cluster0)
#   MONGO_DATABASE     — database name to use
#
# Alternative: provide a full connection URI instead of the fields above.
# When MONGODB_URI is set, it overrides all individual MONGO_* fields.
MONGO_USER=
MONGO_PASSWORD=
MONGO_HOST=
MONGO_APP_NAME=Cluster0
MONGO_DATABASE=discord_music_bot

# Full connection URI (overrides MONGO_* if set):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/?appName=APP_NAME

# ─ Universal Multi-Provider AI DJ (Gemini, Claude, Grok, Qwen, Ollama, etc.) ──
# OPTIONAL — Leave LLM_API_KEY blank to use the built-in local heuristic taste profiler.
# This works out-of-the-box for new users with zero setup. AI features will still run,
# just with a simpler rule-based recommender instead of an LLM.
#
# AI-powered features (when LLM_API_KEY is set):
#   - Natural language mood search: /recommend mood:chill rainy night
#   - Live charismatic DJ commentary between tracks
#   - Song trivia and music taste analysis
#
# Supported providers:
#   - gemini  (default, free tier at https://aistudio.google.com)
#   - claude  (Anthropic Messages API)
#   - openai  (Official OpenAI API)
#   - openai_compatible  (for Grok, Qwen, Groq, DeepSeek, Ollama, OpenRouter, etc.)
#
# Required fields if using any provider:
#   LLM_PROVIDER  — one of: gemini | claude | openai | openai_compatible
#   LLM_API_KEY   — your provider's API key
#   LLM_MODEL     — model name (e.g. gemini-1.5-flash, claude-3-5-sonnet, gpt-4o)
#
# For openai_compatible: also set LLM_BASE_URL to your provider's endpoint.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Enable real-time Web Search Grounding (Google Search for Gemini, DuckDuckGo for Claude/OpenAI/Qwen/etc.)
# Default: true. Set to false to disable web grounding.
LLM_WEB_SEARCH=true

# Optional: Custom endpoint URL (e.g. for Ollama, OpenRouter, Groq, xAI)
# Required for openai_compatible provider.
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Spotify integration lets the bot resolve Spotify track/album/playlist URLs directly
# (otherwise the bot only handles YouTube/SoundCloud links).
#
# Setup: create an app at https://developer.spotify.com/dashboard
#   1. Click "Create app", fill in name/description
#   2. Copy "Client ID" and "Client secret" from the app settings
#   3. Paste them below
#
# Both fields are required for Spotify support. Leave them blank to disable Spotify.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
